@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="mr-6">Jacer</MudText>
        <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.ViewColumn">Board</MudButton>
        <MudButton Href="/templates" Variant="Variant.Text" Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.CalendarViewWeek">Templates</MudButton>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
