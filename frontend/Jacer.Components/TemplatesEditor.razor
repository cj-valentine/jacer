@inject ITemplatesApi Api
@inject ICategoriesApi Cats
@inject ISnackbar Snackbar

@* ─────────────────────────────────────────────────────────────────────────
   Templates editor (Phase 3.5 rework). Seven side-by-side day schedules
   (Mon–Sun) built on the SAME DayTimeline as the board, each with an untimed
   tick-off strip. Untimed items are quick-added and drag onto a day's timeline
   to gain a time; timed items drag to move and resize to change duration. Items
   are editable in place. Lock/unlock and the fortnight A/B toggle are unchanged.
   ───────────────────────────────────────────────────────────────────────── *@

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Templates</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="_loading"
               OnClick="@(() => _creating = !_creating)">
        New template
    </MudButton>
</div>

@if (_creating)
{
    <MudPaper Outlined="true" Class="pa-3 mb-4 d-flex gap-3 align-center flex-wrap">
        <MudTextField @bind-Value="_newName"
                      Placeholder="Template name…"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Style="min-width: 220px;"
                      OnKeyDown="OnNewNameKeyDown" />
        <MudSelect T="Cadence" @bind-Value="_newCadence" Label="Cadence"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 150px;">
            <MudSelectItem Value="Cadence.Weekly">Weekly</MudSelectItem>
            <MudSelectItem Value="Cadence.Fortnightly">Fortnightly</MudSelectItem>
        </MudSelect>
        @if (_newCadence == Cadence.Fortnightly)
        {
            <MudDatePicker @bind-Date="_newWeekAStart" Label="Week A starts"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="min-width: 170px;" />
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(!CanCreate)"
                   OnClick="CreateTemplateAsync">
            Create
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="CancelCreate">
            Cancel
        </MudButton>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_templates.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-6 d-flex flex-column align-center gap-3">
        <MudIcon Icon="@Icons.Material.Filled.CalendarViewWeek" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h6">Shape your week</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Style="max-width: 480px;">
            Templates are your recurring routine. Lock one and Jacer materialises its
            items into tasks each day. Start from a sample week you can edit, or build
            your own from scratch.
        </MudText>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                       Disabled="_seeding"
                       OnClick="SeedStarterAsync">
                Start with a sample week
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="_seeding"
                       OnClick="@(() => _creating = true)">
                Start from scratch
            </MudButton>
        </div>
    </MudPaper>
}
else
{
    <div class="d-flex gap-2 align-center mb-4 flex-wrap">
        <MudSelect T="string" Value="_selectedId" ValueChanged="SelectTemplateAsync"
                   Label="Template" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width: 240px;">
            @foreach (var t in _templates)
            {
                <MudSelectItem Value="@t.Id">@t.Name (@t.Cadence.ToString().ToLowerInvariant())</MudSelectItem>
            }
        </MudSelect>

        @if (_selected is not null)
        {
            @if (_selected.IsLocked)
            {
                <MudChip T="string" Icon="@Icons.Material.Filled.Lock" Color="Color.Success" Size="Size.Small">Locked</MudChip>
                <MudButton StartIcon="@Icons.Material.Filled.LockOpen" Variant="Variant.Outlined"
                           OnClick="UnlockAsync">Unlock to edit</MudButton>
            }
            else
            {
                <MudChip T="string" Icon="@Icons.Material.Filled.LockOpen" Color="Color.Default" Size="Size.Small">Draft</MudChip>
                <MudButton StartIcon="@Icons.Material.Filled.Lock" Variant="Variant.Filled" Color="Color.Success"
                           OnClick="LockAsync">Lock</MudButton>
            }
        }
    </div>

    @if (_selected is not null && _selected.Cadence == Cadence.Fortnightly)
    {
        <div class="d-flex gap-2 align-center mb-4">
            <MudText Typo="Typo.body2">Editing week:</MudText>
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton Color="@(_weekSlot == "A" ? Color.Primary : Color.Default)"
                           Variant="@(_weekSlot == "A" ? Variant.Filled : Variant.Outlined)"
                           OnClick="@(() => SetWeekSlot("A"))">Week A</MudButton>
                <MudButton Color="@(_weekSlot == "B" ? Color.Primary : Color.Default)"
                           Variant="@(_weekSlot == "B" ? Variant.Filled : Variant.Outlined)"
                           OnClick="@(() => SetWeekSlot("B"))">Week B</MudButton>
            </MudButtonGroup>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Items added here belong to week @_weekSlot. (An item can only sit in one week.)
            </MudText>
        </div>
    }

    <div class="tpl-grid">
        @for (var day = 0; day < 7; day++)
        {
            var d = day;
            var locked = _selected!.IsLocked;
            <div class="tpl-col">
                <div class="tpl-col__head">@TimelineGrid.DayLabels[d]</div>

                @* Untimed tick-off strip. *@
                <div class="tpl-col__untimed"
                     @ondragover:preventDefault="true" @ondragover="() => { }"
                     @ondrop="() => OnDropOnUntimedAsync(d)">
                    @foreach (var item in UntimedIn(d))
                    {
                        <div class="tpl-untimed-card" draggable="@((!locked).ToString().ToLowerInvariant())"
                             @ondragstart="() => { _dragItemId = item.Id; }">
                            <TemplateItemBody Item="item" Categories="_categories" Interactive="!locked"
                                              OnEditTitle="EditTitleAsync" OnEditDuration="EditDurationAsync"
                                              OnAssignCategory="AssignCategoryAsync" OnDelete="DeleteItemAsync" />
                        </div>
                    }

                    @if (!locked)
                    {
                        @if (_addDay == d)
                        {
                            <MudTextField @bind-Value="_addTitle" Placeholder="Tick-off task…"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                          AutoFocus="true" OnKeyDown="@(e => OnAddKeyDown(e, d))"
                                          OnBlur="@(() => CommitAddAsync(d))" />
                        }
                        else
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" FullWidth="true"
                                       Class="tpl-add-btn" OnClick="@(() => BeginAdd(d))">Add</MudButton>
                        }
                    }
                </div>

                @* Timed schedule. *@
                <DayTimeline Items="TimedIn(d)" Interactive="!locked" RowHeightPx="18"
                             OnMove="m => OnTimelineMoveAsync(m)"
                             OnResize="r => OnTimelineResizeAsync(r)"
                             OnExternalDrop="min => OnDropOnTimelineAsync(d, min)">
                    <ItemContent>
                        @{
                            var full = ItemById(context.Id);
                        }
                        @if (full is not null)
                        {
                            <TemplateItemBody Item="full" Categories="_categories" Interactive="!locked"
                                              OnEditTitle="EditTitleAsync" OnEditDuration="EditDurationAsync"
                                              OnAssignCategory="AssignCategoryAsync" OnDelete="DeleteItemAsync" />
                        }
                    </ItemContent>
                </DayTimeline>
            </div>
        }
    </div>
}

@code {
    private readonly List<TemplateDto> _templates = [];
    private readonly List<TemplateItemDto> _items = [];
    private readonly List<CategoryDto> _categories = [];
    private string? _selectedId;
    private TemplateDto? _selected;

    private bool _loading = true;
    private string? _error;

    private bool _creating;
    private bool _seeding;
    private string _newName = "";
    private Cadence _newCadence = Cadence.Weekly;
    private DateTime? _newWeekAStart;

    private string _weekSlot = "A";

    // Add-untimed state, and the item currently being dragged strip→timeline.
    private int? _addDay;
    private string _addTitle = "";
    private string? _dragItemId;

    private bool CanCreate =>
        !string.IsNullOrWhiteSpace(_newName)
        && (_newCadence != Cadence.Fortnightly || _newWeekAStart is not null);

    private static readonly (int Day, string Title, int Minutes, string? Time)[] StarterItems =
    [
        (0, "Plan the day", 15, "09:00"),
        (1, "Plan the day", 15, "09:00"),
        (2, "Plan the day", 15, "09:00"),
        (3, "Plan the day", 15, "09:00"),
        (4, "Plan the day", 15, "09:00"),
        (1, "Deep work block", 90, "14:00"),
        (3, "Deep work block", 90, "14:00"),
        (4, "Weekly review", 30, "16:00"),
    ];

    // ── Selection helpers ──────────────────────────────────────────────────
    private IEnumerable<TemplateItemDto> DayItems(int day) =>
        _items.Where(i => i.DayOfWeek == day && MatchesCurrentWeek(i));

    private IEnumerable<TemplateItemDto> UntimedIn(int day) =>
        DayItems(day).Where(i => i.DefaultTime is null).OrderBy(i => i.Title);

    private List<TimelineItem> TimedIn(int day) =>
        DayItems(day).Where(i => i.DefaultTime is not null)
            .Select(i => new TimelineItem
            {
                Id = i.Id,
                Title = i.Title,
                StartMinute = TimelineGrid.MinutesFromHhMm(i.DefaultTime) ?? 9 * 60,
                DurationMinutes = i.DurationMinutes,
                Colour = _categories.FirstOrDefault(c => c.Id == i.CategoryId)?.Colour,
            })
            .ToList();

    private TemplateItemDto? ItemById(string id) => _items.FirstOrDefault(i => i.Id == id);

    private bool MatchesCurrentWeek(TemplateItemDto i)
    {
        if (_selected?.Cadence != Cadence.Fortnightly)
        {
            return true;
        }
        return i.WeekSlot is null || i.WeekSlot == _weekSlot;
    }

    private void SetWeekSlot(string slot)
    {
        _weekSlot = slot;
        _addDay = null;
    }

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories.AddRange(await Cats.ListCategoriesAsync());
        }
        catch
        {
            // Non-fatal — categories just won't colour/label until reachable.
        }
        await ReloadTemplatesAsync();
    }

    private async Task ReloadTemplatesAsync()
    {
        try
        {
            var all = await Api.ListTemplatesAsync();
            _templates.Clear();
            _templates.AddRange(all);
            _error = null;

            if (_templates.Count > 0)
            {
                var keep = _templates.Any(t => t.Id == _selectedId) ? _selectedId! : _templates[0].Id;
                await SelectTemplateAsync(keep);
            }
            else
            {
                _selectedId = null;
                _selected = null;
                _items.Clear();
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the backend: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectTemplateAsync(string id)
    {
        _selectedId = id;
        _selected = _templates.FirstOrDefault(t => t.Id == id);
        await LoadItemsAsync();
    }

    private async Task LoadItemsAsync()
    {
        _items.Clear();
        if (_selectedId is null)
        {
            return;
        }
        try
        {
            _items.AddRange(await Api.ListItemsAsync(_selectedId));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load items: {ex.Message}", Severity.Error);
        }
    }

    // ── Create / seed / lock (unchanged behaviour) ─────────────────────────
    private void CancelCreate()
    {
        _creating = false;
        _newName = "";
        _newCadence = Cadence.Weekly;
        _newWeekAStart = null;
    }

    private async Task OnNewNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _newCadence == Cadence.Weekly && CanCreate)
        {
            await CreateTemplateAsync();
        }
    }

    private async Task CreateTemplateAsync()
    {
        if (!CanCreate)
        {
            return;
        }
        var name = _newName.Trim();
        var payload = new TemplateCreateDto
        {
            Name = name,
            Cadence = _newCadence,
            WeekAStartDate = _newCadence == Cadence.Fortnightly
                ? _newWeekAStart!.Value.ToString("yyyy-MM-dd")
                : null,
        };
        try
        {
            var created = await Api.CreateTemplateAsync(payload);
            CancelCreate();
            _weekSlot = "A";
            await ReloadTemplatesAsync();
            await SelectTemplateAsync(created.Id);
            Snackbar.Add($"Created “{name}”", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not create template: {ex.Message}", Severity.Error);
        }
    }

    private async Task SeedStarterAsync()
    {
        _seeding = true;
        try
        {
            var template = await Api.CreateTemplateAsync(new TemplateCreateDto { Name = "My week" });
            foreach (var (day, title, minutes, time) in StarterItems)
            {
                await Api.CreateItemAsync(template.Id, new TemplateItemCreateDto
                {
                    DayOfWeek = day,
                    Title = title,
                    DurationMinutes = minutes,
                    DefaultTime = time,
                });
            }
            await ReloadTemplatesAsync();
            await SelectTemplateAsync(template.Id);
            Snackbar.Add("Sample week created — edit it, then lock it to start materialising.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not create the sample week: {ex.Message}", Severity.Error);
        }
        finally
        {
            _seeding = false;
        }
    }

    private async Task LockAsync()
    {
        if (_selected is null)
        {
            return;
        }
        try
        {
            await Api.LockTemplateAsync(_selected.Id);
            _selected = _selected with { IsLocked = true };
            ReplaceSelectedInList();
            _addDay = null;
            Snackbar.Add("Template locked — it will now materialise.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not lock: {ex.Message}", Severity.Error);
        }
    }

    private async Task UnlockAsync()
    {
        if (_selected is null)
        {
            return;
        }
        try
        {
            await Api.UnlockTemplateAsync(_selected.Id);
            _selected = _selected with { IsLocked = false };
            ReplaceSelectedInList();
            Snackbar.Add("Template unlocked — edits won't affect already-materialised days.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not unlock: {ex.Message}", Severity.Error);
        }
    }

    private void ReplaceSelectedInList()
    {
        if (_selected is null)
        {
            return;
        }
        var idx = _templates.FindIndex(t => t.Id == _selected.Id);
        if (idx >= 0)
        {
            _templates[idx] = _selected;
        }
    }

    // ── Add untimed items (blur saves — fixes the click-away bug) ───────────
    private void BeginAdd(int day)
    {
        _addDay = day;
        _addTitle = "";
    }

    private async Task OnAddKeyDown(KeyboardEventArgs e, int day)
    {
        if (e.Key == "Escape")
        {
            _addDay = null;
            _addTitle = "";
        }
        else if (e.Key == "Enter")
        {
            await CreateUntimedAsync(day);  // keep the field open for rapid entry
        }
    }

    // Click-away: SAVE if there's text, then close.
    private async Task CommitAddAsync(int day)
    {
        if (_addDay != day)
        {
            return;
        }
        await CreateUntimedAsync(day);
        _addDay = null;
    }

    private async Task CreateUntimedAsync(int day)
    {
        var title = _addTitle.Trim();
        if (title.Length == 0)
        {
            return;
        }
        try
        {
            var created = await Api.CreateItemAsync(_selectedId!, new TemplateItemCreateDto
            {
                DayOfWeek = day,
                Title = title,
                // No DefaultTime — an untimed tick-off item (fixes the forced-slot bug).
                WeekSlot = _selected?.Cadence == Cadence.Fortnightly ? _weekSlot : null,
            });
            _items.Add(created);
            _addTitle = "";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not add item: {ex.Message}", Severity.Error);
        }
    }

    // ── Edit / delete / category ────────────────────────────────────────────
    private async Task EditTitleAsync(TemplateTitleEdit edit)
    {
        try
        {
            await Api.UpdateItemAsync(edit.ItemId, new TemplateItemUpdateDto { Title = edit.Title });
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not rename: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditDurationAsync(TemplateDurationEdit edit)
    {
        try
        {
            await Api.UpdateItemAsync(edit.ItemId, new TemplateItemUpdateDto { DurationMinutes = edit.Minutes });
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not change duration: {ex.Message}", Severity.Error);
        }
    }

    private async Task AssignCategoryAsync(TemplateCategoryAssignment a)
    {
        try
        {
            await Api.SetItemCategoryAsync(a.ItemId, a.CategoryId);
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not set category: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteItemAsync(string itemId)
    {
        try
        {
            await Api.DeleteItemAsync(itemId);
            _items.RemoveAll(i => i.Id == itemId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not remove item: {ex.Message}", Severity.Error);
        }
    }

    // ── Drag: untimed strip ↔ timeline ────────────────────────────────────
    private void ReplaceItem(TemplateItemDto updated)
    {
        var idx = _items.FindIndex(i => i.Id == updated.Id);
        if (idx >= 0)
        {
            _items[idx] = updated;
        }
    }

    private async Task OnTimelineMoveAsync(TimelineMove move)
    {
        var item = ItemById(move.ItemId);
        if (item is null)
        {
            return;
        }
        var previous = item;
        var time = TimelineGrid.HhMmFromMinutes(move.StartMinute);
        ReplaceItem(item with { DefaultTime = time });  // optimistic
        try
        {
            await Api.UpdateItemAsync(move.ItemId, new TemplateItemUpdateDto { DefaultTime = time });
        }
        catch (Exception ex)
        {
            ReplaceItem(previous);
            Snackbar.Add($"Could not move: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnTimelineResizeAsync(TimelineResize resize)
    {
        var item = ItemById(resize.ItemId);
        if (item is null)
        {
            return;
        }
        var previous = item;
        ReplaceItem(item with { DurationMinutes = resize.DurationMinutes });  // optimistic
        try
        {
            await Api.UpdateItemAsync(resize.ItemId, new TemplateItemUpdateDto { DurationMinutes = resize.DurationMinutes });
        }
        catch (Exception ex)
        {
            ReplaceItem(previous);
            Snackbar.Add($"Could not resize: {ex.Message}", Severity.Error);
        }
    }

    // Drop an item onto a day's timeline: give it that time (and that day).
    private async Task OnDropOnTimelineAsync(int day, int startMinute)
    {
        var id = _dragItemId;
        _dragItemId = null;
        if (id is null)
        {
            return;
        }
        try
        {
            await Api.UpdateItemAsync(id, new TemplateItemUpdateDto
            {
                DefaultTime = TimelineGrid.HhMmFromMinutes(startMinute),
                DayOfWeek = day,
            });
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not schedule item: {ex.Message}", Severity.Error);
        }
    }

    // Drop onto another day's untimed strip: move the item to that day (keeps it
    // untimed if it already was; a timed item keeps its time but changes day).
    private async Task OnDropOnUntimedAsync(int day)
    {
        var id = _dragItemId;
        _dragItemId = null;
        if (id is null)
        {
            return;
        }
        try
        {
            await Api.UpdateItemAsync(id, new TemplateItemUpdateDto { DayOfWeek = day });
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not move item: {ex.Message}", Severity.Error);
        }
    }
}

<style>
    .tpl-grid { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 8px; }
    .tpl-col {
        flex: 1 1 0; min-width: 150px;
        border: 1px solid var(--mud-palette-lines-default); border-radius: 6px;
        display: flex; flex-direction: column;
    }
    .tpl-col__head {
        text-align: center; font-weight: 600; padding: 6px 0;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }
    .tpl-col__untimed {
        padding: 6px; min-height: 48px;
        border-bottom: 1px dashed var(--mud-palette-lines-default);
    }
    .tpl-untimed-card { cursor: grab; }
    .tpl-untimed-card > .template-item-body {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 4px; padding: 2px 4px; margin-bottom: 4px;
    }
    .tpl-add-btn { opacity: 0.7; }
</style>
