@* A single status column: header with count, then a stack of task cards. *@

<MudPaper Outlined="true" Class="pa-3 d-flex flex-column" Style="min-width: 280px; flex: 1;">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.subtitle1">@BoardColumns.Label(Status)</MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@Tasks.Count</MudChip>
    </div>

    @if (Tasks.Count == 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">No tasks</MudText>
    }
    else
    {
        @foreach (var task in Tasks)
        {
            <TaskCard Task="task"
                      MoveTargets="BoardColumns.MoveTargetsFor(Status)"
                      OnMove="OnMove" />
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public required TaskStatus Status { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<TaskDto> Tasks { get; set; }

    [Parameter]
    public EventCallback<TaskMove> OnMove { get; set; }
}
